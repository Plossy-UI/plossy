---
import Example from '../../layouts/Example.astro';
import ShopHeader from '../../components/examples/ShopHeader.astro';
import ShopFooter from '../../components/examples/ShopFooter.astro';

const shortcuts = [
  { name: 'Oświetlenie', text: 'Lampy stołowe, wiszące, kinkiety', icon: 'lightbulb', img: '/img/photo-2.svg' },
  { name: 'Ceramika', text: 'Wazony, kubki, misy z kamionki', icon: 'coffee', img: '/img/photo-5.svg' },
  { name: 'Tekstylia', text: 'Koce, poduszki, pościel lniana', icon: 'layers', img: '/img/photo-7.svg' },
  { name: 'Meble', text: 'Fotele, stoliki i regały z dębu', icon: 'box', img: '/img/photo-1.svg' },
];
---

<Example title="Lorem — nie znaleziono strony" description="Zaprojektowana strona błędu 404 sklepu: wyszukiwarka, skróty do kategorii i powrót na stronę główną.">
  <ShopHeader />

  <main>
    <section class="pl-section pl-section-large pl-background-aurora pl-background-dots pl-background-fade e404-hero">
      <div class="pl-container pl-container-small pl-text-center">
        <p class="pl-animation-fade">
          <span class="pl-label pl-label-pill pl-label-dot pl-label-danger">Błąd 404 · strona nie istnieje</span>
        </p>

        <p class="e404-code pl-text-display pl-animation-scale-up" aria-hidden="true">
          <span class="pl-text-gradient pl-text-gradient-animated">4</span><span class="pl-heading-outline e404-zero pl-animation-float">0</span><span class="pl-text-gradient pl-text-gradient-animated">4</span>
        </p>

        <div class="pl-animation-slide-up pl-animation-delay-2">
          <h1 class="pl-heading-small pl-margin-remove-top pl-text-balance">
            Ta półka jest <span class="pl-text-highlight">pusta</span>
          </h1>
          <p class="pl-text-lead pl-text-balance e404-lead">
            Strona, której szukasz, została przeniesiona, wyprzedana albo nigdy nie istniała. Nic straconego — poszukajmy razem.
          </p>

          <form class="pl-search pl-search-large pl-search-pill e404-search" role="search" action="/examples/kategoria/" data-real-submit>
            <span class="pl-search-icon" data-pl-icon="search"></span>
            <input class="pl-search-input" type="search" name="q" placeholder="Czego szukasz? np. lampa stołowa" aria-label="Szukaj w sklepie" />
            <button class="pl-search-clear" type="reset" aria-label="Wyczyść"></button>
            <button class="pl-button pl-button-primary pl-button-pill" type="submit">Szukaj</button>
          </form>

          <div class="pl-flex pl-flex-center pl-flex-middle pl-flex-wrap pl-gap-xsmall pl-margin-top">
            <span class="pl-text-meta">Często szukane:</span>
            <a class="pl-chip" href="/examples/kategoria/">lampa stołowa</a>
            <a class="pl-chip" href="/examples/kategoria/">wazon</a>
            <a class="pl-chip" href="/examples/kategoria/">koc wełniany</a>
            <a class="pl-chip" href="/examples/kategoria/">pościel lniana</a>
          </div>

          <div class="pl-flex pl-flex-center pl-flex-wrap pl-gap-small pl-margin-medium-top">
            <a class="pl-button pl-button-secondary pl-button-large" href="/examples/sklep/"><span data-pl-icon="arrow-left"></span> Wróć na stronę główną</a>
            <a class="pl-button pl-button-ghost pl-button-large" href="/examples/kontakt/"><span data-pl-icon="life-buoy"></span> Zgłoś problem</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pl-section pl-section-muted">
      <div class="pl-container">
        <div class="pl-flex pl-flex-between pl-flex-bottom pl-flex-wrap pl-gap-small pl-margin-medium-bottom">
          <div>
            <p class="pl-heading-eyebrow">Na skróty</p>
            <h2 class="pl-heading-small pl-margin-remove">Popularne kategorie</h2>
          </div>
          <a class="pl-link-arrow" href="/examples/kategoria/">Cała oferta</a>
        </div>

        <div class="pl-grid pl-grid-medium pl-grid-match pl-child-width-1-2@s pl-child-width-1-4@m" data-pl-scrollspy="cls: pl-animation-slide-up; target: > *; delay: 90">
          {
            shortcuts.map((item) => (
              <div>
                <article class="pl-card pl-card-hover">
                  <div class="pl-card-media">
                    <img class="pl-ratio-3-2" src={item.img} alt="" width="1200" height="800" loading="lazy" />
                  </div>
                  <div class="pl-card-body">
                    <h3 class="pl-card-title">
                      <a class="pl-link-heading pl-card-stretch" href="/examples/kategoria/">
                        <span data-pl-icon={item.icon} /> {item.name}
                      </a>
                    </h3>
                    <p class="pl-card-meta">{item.text}</p>
                  </div>
                </article>
              </div>
            ))
          }
        </div>

        <div class="pl-grid pl-grid-medium pl-child-width-1-3@m pl-margin-medium-top">
          <div>
            <a class="pl-tile pl-tile-default pl-tile-small pl-tile-rounded pl-flex pl-flex-middle pl-gap-small pl-link-reset" href="/examples/logowanie/">
              <span class="e404-icon pl-background-primary-soft pl-text-primary"><span data-pl-icon="package"></span></span>
              <span><strong class="pl-display-block">Status zamówienia</strong><span class="pl-text-small pl-text-muted">Sprawdź, gdzie jest paczka</span></span>
            </a>
          </div>
          <div>
            <a class="pl-tile pl-tile-default pl-tile-small pl-tile-rounded pl-flex pl-flex-middle pl-gap-small pl-link-reset" href="/examples/blog/">
              <span class="e404-icon pl-background-primary-soft pl-text-primary"><span data-pl-icon="book-open"></span></span>
              <span><strong class="pl-display-block">Dziennik Lorem</strong><span class="pl-text-small pl-text-muted">Poradniki i inspiracje</span></span>
            </a>
          </div>
          <div>
            <a class="pl-tile pl-tile-default pl-tile-small pl-tile-rounded pl-flex pl-flex-middle pl-gap-small pl-link-reset" href="/examples/kontakt/">
              <span class="e404-icon pl-background-primary-soft pl-text-primary"><span data-pl-icon="message-circle"></span></span>
              <span><strong class="pl-display-block">Napisz do nas</strong><span class="pl-text-small pl-text-muted">Odpowiadamy w kilka godzin</span></span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <ShopFooter />
</Example>

<style>
  /* Wielkie „404" — sama typografia, kolory z narzędzi biblioteki. */
  .e404-code {
    margin: var(--pl-space-4) 0 var(--pl-space-3);
    font-size: clamp(7rem, 4rem + 22vw, 17rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.06em;
    user-select: none;
  }
  .e404-zero {
    display: inline-block;
    margin-inline: 0.02em;
  }
  .e404-lead {
    max-width: 34rem;
    margin-inline: auto;
  }
  .e404-search {
    max-width: 34rem;
    margin: var(--pl-space-6) auto 0;
  }
  .e404-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
  }
</style>
