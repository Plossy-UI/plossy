                </div>
                <div class="pl-card-footer pl-flex-middle pl-gap-small">
                  <span class="pl-avatar pl-avatar-small"><img src={`/img/avatar-${p.av}.svg`} alt="" /></span>
                  <span class="pl-text-small">{p.author}</span>
                  <a class="pl-button pl-button-small pl-margin-auto-left" href="/examples/wpis/">Czytaj</a>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="pl-section pl-section-xsmall pl-border-top">
    <div class="pl-container pl-flex pl-flex-between pl-flex-wrap pl-gap-small pl-text-meta">
      <span>Wzorce kart · zbudowane z Plossy</span>
      <span><a class="pl-link-muted" href="/examples/slidery/">Slidery</a> · <a class="pl-link-muted" href="/examples/landing/">Landing</a> · <a class="pl-link-muted" href="/examples/panel/">Panel</a></span>
    </div>
  </footer>

  <style is:global>
    section[id] {
      scroll-margin-top: 4.5rem;
    }
    /* Mini wykres słupkowy w kaflu bento. */
    .kx-bars {
      display: flex;
      align-items: flex-end;
      gap: 0.4rem;
      height: 4.5rem;
    }
    .kx-bars > span {
      flex: 1;
      height: calc(var(--h) * 1%);
      border-radius: var(--pl-radius-xs) var(--pl-radius-xs) 2px 2px;
      background: color-mix(in oklab, var(--pl-primary) 35%, transparent);
      transition: background-color var(--pl-dur-2) var(--pl-ease), transform var(--pl-dur-3) var(--pl-ease-spring);
      transform-origin: bottom;
    }
    .kx-bars > span:hover {
      background: var(--pl-primary);
      transform: scaleY(1.06);
    }
    /* Wyróżniony plan lekko wystaje ponad sąsiadów. */
    @media (min-width: 960px) {
      .kx-hot {
        margin-block: -0.75rem;
      }
    }
    @media (max-width: 639px) {
      .kx-wide {
        flex-direction: column;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener('click', (event) => {
      const add = event.target.closest('[data-add]');
      if (add) {
        window.Plossy.notification({ title: 'Dodano do koszyka', message: add.dataset.add, status: 'success', timeout: 2600 });
      }
      const toast = event.target.closest('[data-toast]');
      if (toast) window.Plossy.notification({ message: toast.dataset.toast, status: 'primary' });
    });

    document.addEventListener('change', (event) => {
      const billing = event.target.closest('[data-billing]');
      if (billing) {
        const yearly = billing.checked;
        document.querySelectorAll('[data-m][data-y]').forEach((el) => {
          window.Plossy.counter(el).start(Number(yearly ? el.dataset.y : el.dataset.m));
        });
        document.querySelectorAll('[data-billing-note]').forEach((el) => {
          el.textContent = yearly ? 'płatne raz w roku — dwa miesiące gratis' : 'płatne co miesiąc';
        });
      }
      const shop = event.target.closest('[data-shop-switch]');
      if (shop) {
        document.querySelector('[data-shop-state]').textContent = shop.checked
          ? 'Przyjmujemy zamówienia. Wysyłka w 24 h.'
          : 'Przerwa urlopowa — zamówienia wstrzymane.';
      }
    });
  </script>
</Example>
