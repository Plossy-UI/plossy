---
import Example from '../../layouts/Example.astro';

const sections = [
  ['produkty', 'Produkty'],
  ['artykuly', 'Artykuły'],
  ['cennik', 'Cennik'],
  ['zespol', 'Zespół'],
  ['statystyki', 'Statystyki'],
  ['opinie', 'Opinie'],
  ['funkcje', 'Funkcje'],
  ['obrazy', 'Obrazy'],
  ['aktywnosc', 'Aktywność'],
  ['bento', 'Bento'],
  ['szklo', 'Szkło'],
  ['szkielety', 'Szkielety'],
];

const products = [
  { img: 1, name: 'Lampa stołowa Arko', meta: 'Mosiądz szczotkowany', price: '429 zł', old: '', label: 'Nowość', tone: 'spark' },
  { img: 2, name: 'Wazon Fjell', meta: 'Ceramika szkliwiona', price: '189 zł', old: '239 zł', label: '−20%', tone: 'danger' },
  { img: 3, name: 'Pled Skog', meta: 'Wełna merino · 130 × 180', price: '349 zł', old: '', label: '', tone: '' },
  { img: 4, name: 'Krzesło Nord', meta: 'Dąb olejowany', price: '529 zł', old: '', label: 'Bestseller', tone: 'primary' },
];

const posts = [
  { img: 5, cat: 'Poradnik', time: '6 min', title: 'Jak dobrać światło do małego salonu', text: 'Trzy warstwy oświetlenia, które sprawią, że wnętrze wyda się większe i cieplejsze.', author: 'Marta Wolska', av: 2, date: '18 lis 2026' },
  { img: 6, cat: 'Inspiracje', time: '4 min', title: 'Ceramika, która starzeje się pięknie', text: 'O szkliwach reaktywnych, drobnych niedoskonałościach i naczyniach na lata.', author: 'Piotr Lis', av: 3, date: '12 lis 2026' },
  { img: 7, cat: 'Za kulisami', time: '8 min', title: 'Z wizytą w tkalni pod Bergen', text: 'Jak powstaje pled Skog — od runa po ostatni ścieg wykańczający brzeg.', author: 'Ewa Maj', av: 4, date: '3 lis 2026' },
];

const plans = [
  { name: 'Start', desc: 'Dla freelancerów i małych projektów.', m: 0, y: 0, cta: 'Zacznij za darmo', features: ['3 projekty', '2 osoby w zespole', 'Tablice i listy zadań', 'Wsparcie e-mail'], hot: false },
  { name: 'Zespół', desc: 'Dla rosnących zespołów produktowych.', m: 49, y: 39, cta: 'Wypróbuj 14 dni', features: ['Projekty bez limitu', 'Do 25 osób', 'Oś czasu i obciążenie', 'Automatyzacje', 'Wsparcie priorytetowe'], hot: true },
  { name: 'Firma', desc: 'Dla organizacji z wieloma działami.', m: 129, y: 99, cta: 'Porozmawiajmy', features: ['Wszystko z planu Zespół', 'SSO i role niestandardowe', 'Dziennik audytu', 'Opiekun wdrożenia'], hot: false },
];

const team = [
  { av: 1, name: 'Anna Kowalska', role: 'Projektantka produktu', status: 'online', tags: ['Figma', 'Badania'] },
  { av: 2, name: 'Marek Nowak', role: 'Lider inżynierii', status: 'busy', tags: ['TypeScript', 'API'] },
  { av: 3, name: 'Ewa Maj', role: 'Menedżerka produktu', status: 'away', tags: ['Strategia', 'Dane'] },
  { av: 5, name: 'Tomasz Zieliński', role: 'Inżynier frontendu', status: 'online', tags: ['CSS', 'A11y'] },
];

const stats = [
  { label: 'Przychód', icon: 'wallet', tone: 'primary', to: 128400, opts: "suffix: ' zł'", trend: '+12,4%', up: true, goal: 78, pts: '0,22 12,18 24,20 36,12 48,14 60,6 72,9 84,2' },
  { label: 'Zamówienia', icon: 'shopping-bag', tone: 'success', to: 1842, opts: '', trend: '+8,1%', up: true, goal: 64, pts: '0,20 12,16 24,18 36,14 48,9 60,11 72,5 84,4' },
  { label: 'Konwersja', icon: 'target', tone: 'info', to: 4.8, opts: "decimals: 1; suffix: '%'", trend: '+0,6 pp', up: true, goal: 48, pts: '0,14 12,16 24,10 36,12 48,8 60,10 72,6 84,7' },
  { label: 'Zwroty', icon: 'rotate-ccw', tone: 'warning', to: 37, opts: '', trend: '−3,2%', up: false, goal: 22, pts: '0,6 12,9 24,7 36,12 48,11 60,15 72,14 84,19' },
];

const quotes = [
  { av: 4, name: 'Karolina Bąk', role: 'Architektka wnętrz, Gdynia', text: 'Lampa Arko dotarła w dwa dni, zapakowana jak prezent. Światło jest ciepłe i miękkie — dokładnie takie, jak na zdjęciach.', stars: 5 },
  { av: 5, name: 'Jakub Sowa', role: 'Właściciel kawiarni Mielone', text: 'Zamówiliśmy czterdzieści kubków z serii Fjell. Po roku codziennego zmywania wyglądają jak nowe. Goście pytają, skąd są.', stars: 5 },
  { av: 6, name: 'Zofia Rak', role: 'Stała klientka', text: 'Wymiana pledu na inny kolor zajęła jedną wiadomość. Rzadko spotyka się tak ludzką obsługę w sklepie internetowym.', stars: 4 },
];

const features = [
  { icon: 'zap', tone: 'primary', title: 'Błyskawiczny start', text: 'Jeden plik CSS i jeden skrypt. Komponenty inicjalizują się same z atrybutów.' },
  { icon: 'palette', tone: 'success', title: 'Motywy i akcenty', text: 'Jasny i ciemny motyw oraz akcenty kolorystyczne oparte na tokenach.' },
  { icon: 'shield-check', tone: 'info', title: 'Dostępność', text: 'Role ARIA, obsługa klawiatury i widoczny fokus w każdym komponencie.' },
  { icon: 'layers', tone: 'warning', title: 'Warstwy bez bólu', text: 'Modale, dropy i podpowiedzi korzystają z top-layer — bez wojen o z-index.' },
  { icon: 'move', tone: 'danger', title: 'Fizyczne gesty', text: 'Slidery z bezwładnością i sprężystym dociąganiem, które czują palec.' },
  { icon: 'puzzle', tone: 'primary', title: 'Zero zależności', text: 'Czysty JavaScript w modułach ES. Bierzesz tylko to, czego potrzebujesz.' },
];

const gallery = [
  { img: 8, eyebrow: 'Kolekcja', title: 'Jesienne światło', text: '12 produktów' },
  { img: 2, eyebrow: 'Ceramika', title: 'Seria Fjell', text: '24 produkty' },
  { img: 6, eyebrow: 'Tekstylia', title: 'Wełna i len', text: '18 produktów' },
];

const activity = [
  { icon: 'shopping-bag', tone: 'primary', title: 'Nowe zamówienie #10482', text: 'Lampa Arko × 1, Wazon Fjell × 2', time: '2 min' },
  { icon: 'message-circle', tone: 'info', title: 'Karolina dodała opinię', text: '„Światło jest ciepłe i miękkie…"', time: '14 min' },
  { icon: 'truck', tone: 'success', title: 'Paczka #10471 doręczona', text: 'Odebrana w punkcie w Gdyni', time: '1 godz.' },
  { icon: 'triangle-alert', tone: 'warning', title: 'Niski stan magazynowy', text: 'Pled Skog, kolor mech — zostały 3 szt.', time: '3 godz.' },
];

const stars = (n: number) => Array.from({ length: 5 }, (_, i) => i < n);
---

<Example title="Karty" description="Galeria wzorców kart zbudowanych z komponentów Plossy: produkty, artykuły, cenniki, statystyki, bento i inne.">
  <header class="pl-navbar-container pl-navbar-glass pl-navbar-sticky" data-pl-navbar>
    <nav class="pl-navbar" aria-label="Wzorce">
      <div class="pl-navbar-left">
        <a class="pl-navbar-logo" href="/examples/"><span class="pl-navbar-logo-mark"></span> Wzorce</a>
        <ul class="pl-navbar-nav pl-visible@s">
          <li class="pl-active"><a href="/examples/karty/">Karty</a></li>
          <li><a href="/examples/slidery/">Slidery</a></li>
          <li><a href="/examples/landing/">Landing</a></li>
          <li><a href="/examples/panel/">Panel</a></li>
        </ul>
      </div>
      <div class="pl-navbar-right">
        <span class="pl-navbar-item pl-text-meta pl-visible@m">12 grup · 40+ kart</span>
        <button class="pl-button pl-button-small" type="button">Spis treści <span data-pl-icon="chevron-down"></span></button>
        <div class="pl-drop pl-dropdown" data-pl-drop="mode: click; pos: bottom-end">
          <ul class="pl-dropdown-nav">
            {sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <!-- Nagłówek strony -->
    <section class="pl-section pl-background-dots pl-background-fade">
      <div class="pl-container pl-container-small pl-text-center" data-pl-scrollspy="cls: pl-animation-slide-up-small; target: > *; delay: 80">
        <p class="pl-heading-eyebrow pl-heading-eyebrow-center">Wzorce interfejsu</p>
        <h1 class="pl-heading-medium pl-text-balance">Karty na <span class="pl-heading-mark">każdą okazję</span></h1>
        <p class="pl-text-lead pl-text-muted pl-text-balance">Dwanaście grup gotowych wzorców — od kart produktu po interaktywne bento. Wszystko z klas Plossy, bez dodatkowego CSS.</p>
        <div class="pl-chip-group pl-flex-center pl-margin-medium-top">
          {sections.map(([id, label]) => <a class="pl-chip" href={`#${id}`}>{label}</a>)}
        </div>
      </div>
    </section>

    <!-- 1. Produkty -->
    <section class="pl-section pl-section-small" id="produkty">
      <div class="pl-container">
        <p class="pl-heading-eyebrow">01 · Sklep</p>
        <h2>Karty produktu</h2>
        <p class="pl-text-muted">Cztery style: klasyczny, z nakładką, poziomy i kompaktowy.</p>

        <h3 class="pl-text-eyebrow pl-margin-medium-top">Klasyczna</h3>
        <div class="pl-grid pl-child-width-1-1 pl-grid-match pl-child-width-1-2@s pl-child-width-1-4@l pl-margin-small-top" data-pl-scrollspy="cls: pl-animation-slide-up-small; target: > *; delay: 70">
          {products.map((p) => (
            <div>
              <article class="pl-card pl-card-hover pl-visible-toggle">
                {p.label && <span class={`pl-card-badge pl-label pl-label-${p.tone}`}>{p.label}</span>}
                <figure class="pl-card-media pl-image pl-ratio-4-3"><img src={`/img/photo-${p.img}.svg`} alt="" loading="lazy" /></figure>
                <div class="pl-card-body">
                  <p class="pl-card-meta">{p.meta}</p>
                  <h4 class="pl-card-title"><a class="pl-link-heading pl-card-stretch" href="/examples/produkt/">{p.name}</a></h4>
                  <div class="pl-flex pl-flex-middle pl-flex-between pl-margin-small-top">
                    <p class="pl-margin-remove">
                      <strong class="pl-text-lg pl-text-display">{p.price}</strong>
                      {p.old && <s class="pl-text-meta pl-margin-small-left">{p.old}</s>}
                    </p>
                    <button class="pl-button pl-button-primary pl-button-soft pl-button-icon pl-button-small pl-position-relative pl-position-z-index" type="button" aria-label={`Dodaj do koszyka: ${p.name}`} data-add={p.name} data-pl-tooltip="Do koszyka"><span data-pl-icon="shopping-bag"></span></button>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>

        <div class="pl-grid pl-margin-medium-top">
          <div class="pl-width-1-1 pl-width-1-2@m">
            <h3 class="pl-text-eyebrow">Z nakładką</h3>
            <div class="pl-grid pl-grid-small pl-child-width-1-2 pl-margin-small-top">
              {products.slice(0, 2).map((p) => (
                <div>
                  <a class="pl-image pl-image-rounded pl-image-zoom pl-ratio-3-4 pl-transition-toggle" href="/examples/produkt/">
                    <img src={`/img/photo-${p.img + 4}.svg`} alt="" loading="lazy" />
                    <span class="pl-position-top-left pl-position-small pl-label pl-label-solid pl-label-secondary">{p.meta.split(' ')[0]}</span>
                    <div class="pl-overlay pl-overlay-gradient pl-position-bottom">
                      <h4 class="pl-margin-remove">{p.name}</h4>
                      <p class="pl-margin-remove">{p.price}</p>
                      <p class="pl-margin-small-top pl-margin-remove-bottom pl-transition-slide-bottom-small"><span class="pl-button pl-button-small pl-button-pill">Zobacz produkt <span class="pl-button-arrow" data-pl-icon="arrow-right"></span></span></p>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          </div>
          <div class="pl-width-1-1 pl-width-1-2@m">
            <h3 class="pl-text-eyebrow">Pozioma</h3>
            <article class="pl-card pl-card-horizontal pl-card-hover pl-margin-small-top">
              <figure class="pl-card-media"><img src="/img/photo-3.svg" alt="" loading="lazy" /></figure>
              <div class="pl-card-body">
                <p class="pl-card-meta">Tekstylia · dostępny od ręki</p>
                <h4 class="pl-card-title">Pled Skog, kolor mech</h4>
                <p class="pl-card-text pl-text-clamp-2">Gęsto tkana wełna merino z ręcznie wykańczanym brzegiem. Ciepły, ale nie gryzie.</p>
                <div class="pl-flex pl-flex-middle pl-gap-small pl-margin-small-top">
                  <strong class="pl-text-lg pl-text-display">349 zł</strong>
                  <span class="pl-label pl-label-success pl-label-dot">W magazynie</span>
                </div>
              </div>
            </article>

            <h3 class="pl-text-eyebrow pl-margin-medium-top">Kompaktowa</h3>
            <div class="pl-grid pl-child-width-1-1 pl-grid-small pl-child-width-1-2@s pl-margin-small-top">
              {products.slice(0, 4).map((p) => (
                <div>
                  <div class="pl-card pl-card-small pl-card-outline pl-hover-lift">
                    <div class="pl-card-body pl-flex pl-flex-middle pl-gap-small">
                      <img class="pl-image-rounded-small pl-object-cover pl-flex-none" src={`/img/photo-${p.img}.svg`} alt="" width="52" height="52" style="width: 3.25rem; height: 3.25rem" />
                      <div class="pl-flex-1 pl-text-truncate">
                        <div class="pl-text-medium pl-text-truncate">{p.name}</div>
                        <div class="pl-text-meta">{p.price}</div>
                      </div>
                      <button class="pl-icon-button" type="button" aria-label={`Dodaj: ${p.name}`} data-add={p.name}><span data-pl-icon="plus"></span></button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Artykuły -->
    <section class="pl-section pl-section-small pl-section-muted" id="artykuly">
      <div class="pl-container">
        <p class="pl-heading-eyebrow">02 · Treści</p>
        <h2>Karty artykułów</h2>
        <p class="pl-text-muted">Wpis wyróżniony obok listy zwykłych kart — z autorem, kategorią i czasem czytania.</p>

        <div class="pl-grid pl-child-width-1-1 pl-grid-match pl-child-width-1-3@m pl-margin-medium-top" data-pl-scrollspy="cls: pl-animation-slide-up-small; target: > *; delay: 80">
          {posts.map((p) => (
            <div>
              <article class="pl-card pl-card-hover">
                <figure class="pl-card-media pl-image pl-ratio-16-9"><img src={`/img/photo-${p.img}.svg`} alt="" loading="lazy" /></figure>
                <div class="pl-card-body">
                  <p class="pl-flex pl-flex-middle pl-gap-small pl-margin-remove">
                    <span class="pl-label pl-label-primary">{p.cat}</span>
                    <span class="pl-text-meta"><span data-pl-icon="clock" class="pl-icon-small"></span> {p.time} czytania</span>
                  </p>
                  <h3 class="pl-card-title pl-margin-small-top"><a class="pl-link-heading pl-card-stretch" href="/examples/wpis/">{p.title}</a></h3>
                  <p class="pl-card-text pl-text-clamp-2">{p.text}</p>
                </div>
                <div class="pl-card-footer">
                  <div class="pl-avatar-item">
                    <span class="pl-avatar pl-avatar-small"><img src={`/img/avatar-${p.av}.svg`} alt="" /></span>
                    <span class="pl-avatar-text">
                      <span class="pl-avatar-name">{p.author}</span>
                      <span class="pl-avatar-meta">{p.date}</span>
                    </span>
                  </div>
                  <span class="pl-margin-auto-left pl-text-muted" data-pl-icon="arrow-up-right"></span>
                </div>
              </article>
            </div>
          ))}
        </div>

        <article class="pl-card pl-card-horizontal pl-card-secondary pl-margin-medium-top kx-wide">
          <div class="pl-card-body pl-card-large">
            <p class="pl-text-eyebrow">Temat miesiąca</p>
            <h3 class="pl-card-title pl-text-2xl">Dom, który oddycha: przewodnik po naturalnych materiałach</h3>
            <p class="pl-card-text">Len, wełna, dąb i kamionka — jak je łączyć, pielęgnować i dlaczego z wiekiem tylko zyskują.</p>
            <p class="pl-margin-remove-bottom"><a class="pl-button pl-button-primary pl-button-pill" href="/examples/wpis/">Czytaj przewodnik <span class="pl-button-arrow" data-pl-icon="arrow-right"></span></a></p>
          </div>
          <figure class="pl-card-media pl-visible@s"><img src="/img/photo-8.svg" alt="" loading="lazy" /></figure>
        </article>
      </div>
    </section>

    <!-- 3. Cennik -->
    <section class="pl-section pl-section-small" id="cennik">
      <div class="pl-container">
        <div class="pl-text-center">
          <p class="pl-heading-eyebrow pl-heading-eyebrow-center">03 · Sprzedaż</p>
          <h2>Karty cennika</h2>
          <p class="pl-text-muted">Trzy plany, wyróżniony środkowy i przełącznik okresu rozliczenia.</p>
          <label class="pl-form-check pl-margin-small-top">
            <span class="pl-text-medium">Miesięcznie</span>
            <input class="pl-switch" type="checkbox" role="switch" data-billing aria-label="Rozliczenie roczne" />
            <span class="pl-text-medium">Rocznie</span>
            <span class="pl-label pl-label-spark pl-label-pill">−20%</span>
          </label>
        </div>

        <div class="pl-grid pl-child-width-1-1 pl-grid-match pl-grid-middle pl-child-width-1-3@m pl-margin-medium-top" data-pl-scrollspy="cls: pl-animation-slide-up-small; target: > *; delay: 90">
          {plans.map((p) => (
            <div>
              <div class={`pl-card ${p.hot ? 'pl-card-accent pl-box-shadow-large kx-hot' : ''}`} data-pl-spotlight={p.hot ? '' : undefined}>
                {p.hot && <span class="pl-card-badge pl-label pl-label-solid pl-label-primary pl-label-pill">Najczęściej wybierany</span>}
                <div class={`pl-card-body ${p.hot ? 'pl-card-large' : ''}`}>
                  <h3 class="pl-card-title">{p.name}</h3>
                  <p class="pl-card-meta">{p.desc}</p>
                  <p class="pl-margin-small-top pl-margin-remove-bottom">
                    <span class="pl-text-4xl pl-text-display pl-text-semibold pl-text-tabular" data-pl-counter={`to: ${p.m}; duration: 500`} data-m={p.m} data-y={p.y}>{p.m}</span>
                    <span class="pl-text-muted"> zł / os. mies.</span>
                  </p>
                  <p class="pl-text-meta" data-billing-note>płatne co miesiąc</p>
                  <a class={`pl-button pl-button-block ${p.hot ? 'pl-button-primary' : ''}`} href="#">{p.cta}</a>
                  <ul class="pl-list pl-list-check pl-margin-top pl-margin-remove-bottom">
                    {p.features.map((f) => <li>{f}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Zespół -->
    <section class="pl-section pl-section-small pl-section-muted" id="zespol">
      <div class="pl-container">
        <p class="pl-heading-eyebrow">04 · Ludzie</p>
        <h2>Karty profilu i zespołu</h2>
        <p class="pl-text-muted">Awatar ze statusem, rola, umiejętności i szybkie akcje.</p>

        <div class="pl-grid pl-child-width-1-1 pl-grid-match pl-child-width-1-2@s pl-child-width-1-4@l pl-margin-medium-top" data-pl-scrollspy="cls: pl-animation-scale-up; target: > *; delay: 70">
          {team.map((t) => (
            <div>
              <div class="pl-card pl-card-hover pl-text-center">
                <div class="pl-card-body">
                  <span class="pl-avatar pl-avatar-xlarge pl-avatar-ring">
                    <img src={`/img/avatar-${t.av}.svg`} alt="" />
                    <span class={`pl-avatar-status pl-avatar-status-${t.status}`}></span>
                  </span>
                  <h3 class="pl-card-title pl-margin-small-top">{t.name}</h3>
                  <p class="pl-card-meta">{t.role}</p>
                  <div class="pl-chip-group pl-flex-center pl-margin-small-top">
                    {t.tags.map((tag) => <span class="pl-chip pl-chip-small">{tag}</span>)}
                  </div>
                </div>
                <div class="pl-card-footer pl-flex-center">
                  <ul class="pl-iconnav">
                    <li><a href="#" aria-label="Napisz e-mail" data-pl-tooltip="E-mail"><span data-pl-icon="mail"></span></a></li>
                    <li><a href="#" aria-label="Wiadomość" data-pl-tooltip="Wiadomość"><span data-pl-icon="message-circle"></span></a></li>
                    <li><a href="#" aria-label="Zadzwoń" data-pl-tooltip="Telefon"><span data-pl-icon="phone"></span></a></li>
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="pl-card pl-margin-medium-top">
          <div class="pl-card-body pl-flex pl-flex-middle pl-flex-wrap pl-gap-medium">
            <div class="pl-avatar-group pl-avatar-group-expand">
              {[1, 2, 3, 4, 5].map((n) => <span class="pl-avatar pl-avatar-large"><img src={`/img/avatar-${n}.svg`} alt="" /></span>)}
              <span class="pl-avatar pl-avatar-large pl-avatar-more">+12</span>
            </div>
            <div class="pl-flex-1" style="min-width: 14rem">
              <h3 class="pl-card-title">Zespół produktowy</h3>
              <p class="pl-card-meta pl-margin-remove">17 osób · 4 strefy czasowe · 6 otwartych rekrutacji</p>
            </div>
            <a class="pl-button pl-button-primary" href="#"><span data-pl-icon="user-plus"></span> Zaproś osobę</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Statystyki -->
    <section class="pl-section pl-section-small" id="statystyki">
      <div class="pl-container">
        <p class="pl-heading-eyebrow">05 · Dane</p>
        <h2>Karty statystyk i KPI</h2>
