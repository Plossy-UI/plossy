---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/bricolage-grotesque';
// Kroje presetów stylu
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/jost';
import '@fontsource-variable/baloo-tamma-2';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/nunito';
import '@fontsource-variable/fraunces';
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import '@plossy/scss/plossy.scss';
import '../styles/docs.scss';
import Header from '../components/Header.astro';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = 'Plossy — lekka, nowoczesna biblioteka komponentów UI.', home = false } = Astro.props;
const fullTitle = title ? `${title} · Plossy` : 'Plossy — nowoczesne komponenty UI';
---

<!doctype html>
<html lang="pl" data-pl-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const params = new URLSearchParams(location.search);
          const theme = params.get('theme') || localStorage.getItem('plossy-theme');
          root.dataset.plTheme = theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const accent = params.get('accent') || localStorage.getItem('plossy-accent');
          if (accent) root.dataset.plAccent = accent;
          const style = params.get('style') || localStorage.getItem('plossy-style');
          if (style && style !== 'soft') root.dataset.plStyle = style;
        } catch {}
        // Płynne przejścia: nowy dokument przejmuje motyw, akcent i styl bieżącego (bez mignięcia).
        document.addEventListener('astro:before-swap', (event) => {
          const next = event.newDocument.documentElement;
          for (const key of ['plTheme', 'plAccent', 'plStyle']) {
            if (root.dataset[key]) next.dataset[key] = root.dataset[key];
            else delete next.dataset[key];
          }
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body class:list={['docs', { 'docs-home': home }]}>
    <a class="docs-skip" href="#main">Przejdź do treści</a>
    <Header home={home} />
    <slot />
    <Search />
    <script>
      import '@plossy/js/index.js';
      import '../scripts/docs.js';
    </script>
  </body>
</html>
