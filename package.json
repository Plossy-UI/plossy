{
  "name": "plossy",
  "version": "0.3.1",
  "description": "Plossy — jeden framework, wiele osobowości. Biblioteka komponentów UI (CSS + vanilla JS) z przełączanymi stylami, motywami i akcentami.",
  "type": "module",
  "license": "MIT",
  "main": "dist/plossy.esm.js",
  "types": "dist/plossy.d.ts",
  "style": "dist/plossy.css",
  "scripts": {
    "dev": "astro dev --root docs",
    "docs": "node build/clean-docs-cache.mjs && astro build --root docs",
    "preview": "astro preview --root docs",
    "icons": "node build/icons.mjs",
    "dist": "node build/dist.mjs",
    "build": "npm run dist && npm run docs",
    "test": "npm run docs && playwright test",
    "test:zrzuty": "npm run docs && playwright test wyglad --update-snapshots",
    "test:a11y-spis": "npm run docs && A11Y_SPIS=1 playwright test dostepnosc"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@fontsource-variable/baloo-tamma-2": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "astro": "^6.0.5",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.80.0",
    "sass": "^1.108.2"
  },
  "files": [
    "dist/"
  ],
  "module": "dist/plossy.esm.js",
  "author": "Katarzyna Płoska",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plossy-ui/plossy.git"
  }
}
